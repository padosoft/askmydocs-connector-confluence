{
    "name": "padosoft/askmydocs-connector-confluence",
    "description": "Confluence Cloud connector for AskMyDocs — OAuth2 3LO sync + storage-format XHTML→markdown rendering + page-hierarchy chunker. Drop-in Laravel package that auto-registers via composer extra discovery.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "askmydocs",
        "confluence",
        "atlassian",
        "oauth",
        "rag",
        "knowledge-base",
        "padosoft"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "padosoft/askmydocs-connector-base": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\AskMyDocsConnectorConfluence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\AskMyDocsConnectorConfluence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\AskMyDocsConnectorConfluence\\ConfluenceServiceProvider"
            ]
        },
        "askmydocs": {
            "connectors": [
                "Padosoft\\AskMyDocsConnectorConfluence\\ConfluenceConnector"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
